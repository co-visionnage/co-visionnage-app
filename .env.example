# General
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=

# Postgres
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Minio
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web Push (generate with: node -e "console.log(require('web-push').generateVAPIDKeys())")
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Import sources (optional — import UI is hidden until a key is set)
KINOPOISK_API_KEY=
OMDB_API_KEY=

# Trakt watchlist import (register a free app at trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=

# Next-episode air-date calendar (free key at themoviedb.org/settings/api)
TMDB_API_KEY=

# Scheduled jobs (call with header "Authorization: Bearer <CRON_SECRET>"
# from your scheduler, e.g. Vercel Cron or a cron container calling curl):
# POST /api/cron/check-new-seasons
# POST /api/cron/check-inactive[?days=14]
CRON_SECRET=
