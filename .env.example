# =============================================================================
# Required — the app and `docker compose up` won't start without these.
# =============================================================================

# Superuser credentials used once to bootstrap the Postgres container
# (creates the app_user role, see database/init.sh) and by `pnpm migrate`
# to apply schema changes. Never used by the running app itself.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Password for the app_user role that init.sh creates. Must match the
# app_user credentials embedded in DATABASE_URL below.
APP_DB_PASSWORD=

# The app's own connection string, authenticated as app_user (RLS-scoped —
# see database/migrations/, it owns none of the schema). Not the same
# credentials as POSTGRES_USER/POSTGRES_PASSWORD above.
DATABASE_URL=

# =============================================================================
# Object storage (Minio/S3) — required only for uploading a custom series
# poster image; every other feature works without it.
# =============================================================================

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# =============================================================================
# Optional integrations — each feature they power is hidden or degrades
# gracefully (never crashes the app) when its key is left unset.
# =============================================================================

# GitHub OAuth login (the "Войти по GitHub" button always renders; without
# these it errors when clicked rather than being hidden)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web Push notifications (generate with:
# node -e "console.log(require('web-push').generateVAPIDKeys())")
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Resend (transactional email digests on new/watched series)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Import sources for the add-series search/bulk-import UI — each is
# independently optional; the corresponding source just returns no results
# without its key
KINOPOISK_API_KEY=
OMDB_API_KEY=
# Register a free app at trakt.tv/oauth/applications
TRAKT_CLIENT_ID=
# Free key at themoviedb.org/settings/api — powers the next-episode
# air-date calendar
TMDB_API_KEY=

# Scheduled jobs (call with header "Authorization: Bearer <CRON_SECRET>"
# from your scheduler, e.g. Vercel Cron or a cron container calling curl):
# POST /api/cron/check-new-seasons
# POST /api/cron/check-next-episode
# POST /api/cron/check-inactive[?days=14]
# Without this set, every cron route rejects with 401 rather than running
# unauthenticated.
CRON_SECRET=
