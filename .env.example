# The frontend is a thin client of the Go API: it holds no database
# credentials, no mail/push keys and no third-party API keys. Those live in
# ../notrecinema-api/.env.example and ../notrecinema-worker/.env.example.

# =============================================================================
# Required
# =============================================================================

# Where the Go API is reachable FROM THE FRONTEND SERVER. The browser never
# talks to it directly: it calls /api/v1/* on the frontend's own origin and
# Next.js proxies that to this address (see next.config.ts), so the session
# cookie stays first-party.
# Baked in at build time (the Dockerfile takes it as a build argument), so
# rebuild the image when it changes.
API_URL=http://localhost:8080

# =============================================================================
# Optional
# =============================================================================

# Public key for browser push subscriptions; must be the public half of the
# VAPID pair the worker signs with (VAPID_PUBLIC_KEY in the worker's .env).
# Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Host of the bucket that serves uploaded posters, so next/image may load
# from it (the same value as STORAGE_PUBLIC_URL in the API's .env).
STORAGE_PUBLIC_URL=
